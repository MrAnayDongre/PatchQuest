# Copy to .env and fill in only the providers you use.
# Never commit .env to version control.

# LLM providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# Web search (optional)
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# SERPAPI_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Calendar (optional)
# CALDAV_URL=
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
# GOOGLE_CALENDAR_CREDENTIALS=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=

# PatchQuest config path override (optional)
# PATCHQUEST_CONFIG=/path/to/config.yaml
